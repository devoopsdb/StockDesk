<UserControl x:Class="StockDesk.Controls.QuantityStepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="RootStepper"
             Height="34"
             VerticalAlignment="Center">
    <Border BorderThickness="1"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>

            <!-- Decrement (-) Button -->
            <Button x:Name="DecrementButton"
                    Grid.Column="0"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Cursor="Hand"
                    ToolTip="Azalt (-1)"
                    Click="OnDecrementClick"
                    IsEnabled="{Binding IsDecrementEnabled, ElementName=RootStepper}">
                <ui:SymbolIcon Symbol="Subtract20"
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Button>

            <!-- Left Divider -->
            <Rectangle Grid.Column="1"
                       Fill="{DynamicResource ControlStrokeColorDefaultBrush}"
                       Margin="0,4" />

            <!-- Direct Numeric Input -->
            <TextBox x:Name="ValueTextBox"
                     Grid.Column="2"
                     BorderThickness="0"
                     Background="Transparent"
                     TextAlignment="Center"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Padding="4,0"
                     PreviewTextInput="OnTextBoxPreviewTextInput"
                     TextChanged="OnTextBoxTextChanged"
                     LostFocus="OnTextBoxLostFocus"
                     KeyDown="OnTextBoxKeyDown" />

            <!-- Right Divider -->
            <Rectangle Grid.Column="3"
                       Fill="{DynamicResource ControlStrokeColorDefaultBrush}"
                       Margin="0,4" />

            <!-- Increment (+) Button -->
            <Button x:Name="IncrementButton"
                    Grid.Column="4"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Cursor="Hand"
                    ToolTip="Artır (+1)"
                    Click="OnIncrementClick"
                    IsEnabled="{Binding IsIncrementEnabled, ElementName=RootStepper}">
                <ui:SymbolIcon Symbol="Add20"
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
