<Window x:Class="StockDesk.Views.Dialogs.ReplenishDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:StockDesk.ViewModels"
        xmlns:converters="clr-namespace:StockDesk.Common.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ReplenishDialogViewModel}"
        Title="Qalığın Artırılması (Mədaxil)"
        Height="420" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Məhsul Qalığının Artırılması"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">
            <!-- Product Info card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Product.Name}"
                                   FontWeight="SemiBold"
                                   FontSize="15" />
                        <TextBlock Text="{Binding Product.CategoryName}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Cari qalıq:"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding Product.CurrentBalance, StringFormat='{}{0} ədəd'}"
                                   FontWeight="Bold"
                                   FontSize="14" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quantity to add -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Əlavə ediləcək say *"
                           FontWeight="Medium"
                           Margin="0,0,0,6" />
                <ui:NumberBox Value="{Binding Quantity, Mode=TwoWay}"
                              Minimum="1"
                              SpinButtonPlacementMode="Inline"
                              SmallChange="1"
                              LargeChange="10" />
            </StackPanel>

            <!-- Note -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Qeyd (istəyə bağlı)"
                           FontWeight="Medium"
                           Margin="0,0,0,6" />
                <ui:TextBox PlaceholderText="Məsələn: Təchizatçıdan yeni partiya..."
                            Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </StackPanel>

        <!-- Error message -->
        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="#DC3545"
                   FontWeight="Medium"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <ui:Button Content="Ləğv et"
                       Appearance="Secondary"
                       Click="OnCancelClick"
                       Width="100"
                       Margin="0,0,10,0" />
            <ui:Button Content="Mədaxil et"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Add24}"
                       Click="OnConfirmClick"
                       Width="130" />
        </StackPanel>
    </Grid>
</Window>
