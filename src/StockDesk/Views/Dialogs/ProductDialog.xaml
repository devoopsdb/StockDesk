<Window x:Class="StockDesk.Views.Dialogs.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:StockDesk.ViewModels"
        xmlns:controls="clr-namespace:StockDesk.Controls"
        xmlns:converters="clr-namespace:StockDesk.Common.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ProductDialogViewModel}"
        Title="{Binding DialogTitle}"
        Height="620" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="{Binding DialogTitle}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- Photo Section -->
                <TextBlock Text="Məhsulun Şəkli"
                           FontWeight="Medium"
                           FontSize="14"
                           Margin="0,0,0,8" />
                
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Preview Image or Placeholder -->
                        <Border Width="160" Height="160"
                                CornerRadius="6"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                ClipToBounds="True"
                                Margin="0,0,0,10">
                            <Grid>
                                <!-- Placeholder icon -->
                                <ui:SymbolIcon Symbol="Image24"
                                               FontSize="48"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVis}}" />
                                
                                <!-- Image Preview -->
                                <Image Source="{Binding PreviewImageSource}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>

                        <!-- Photo Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Content="Şəkil seç"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Appearance="Secondary"
                                       Command="{Binding ChoosePhotoCommand}"
                                       Margin="0,0,8,0" />
                            
                            <ui:Button Content="Sil"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       Appearance="Danger"
                                       Command="{Binding RemovePhotoCommand}"
                                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Name Input -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Məhsulun adı *"
                               FontWeight="Medium"
                               Margin="0,0,0,6" />
                    <ui:TextBox PlaceholderText="Məsələn: Dell Vostro 3520..."
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                Icon="{ui:SymbolIcon Box24}" />
                </StackPanel>

                <!-- Category ComboBox -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Kateqoriya *"
                               FontWeight="Medium"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- Initial Quantity (Only for new product) -->
                <StackPanel Margin="0,0,0,14"
                            Visibility="{Binding IsInitialQuantityVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="İlkin say (qalıq)"
                               FontWeight="Medium"
                               Margin="0,0,0,6" />
                    <controls:QuantityStepper Value="{Binding InitialQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Minimum="0" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Error message -->
        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="#DC3545"
                   FontWeight="Medium"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

        <!-- Dialog Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <ui:Button Content="Ləğv et"
                       Appearance="Secondary"
                       Click="OnCancelClick"
                       Width="100"
                       Margin="0,0,10,0" />
            <ui:Button Content="Yadda saxla"
                       Appearance="Primary"
                       Click="OnSaveClick"
                       Width="120" />
        </StackPanel>
    </Grid>
</Window>
