<Window x:Class="StockDesk.Views.Dialogs.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:StockDesk.ViewModels"
        xmlns:converters="clr-namespace:StockDesk.Common.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:UpdateDialogViewModel}"
        Title="Tətbiqin Yenilənməsi"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Content -->
            <RowDefinition Height="*" />
            <!-- Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <ui:SymbolIcon Symbol="ArrowSync24"
                           FontSize="24"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           Margin="0,0,12,0" />
            <TextBlock Text="Tətbiqin Yenilənməsi"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- 2. CONTENT SECTIONS (Based on CurrentMode) -->
        <Grid Grid.Row="1" Margin="0,0,0,24">

            <!-- A. Checking Mode -->
            <StackPanel Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,20">
                <ui:ProgressRing IsIndeterminate="True"
                                 Width="48"
                                 Height="48"
                                 Margin="0,0,0,16" />
                <TextBlock Text="Yeniləmələr yoxlanılır, zəhmət olmasa gözləyin..."
                           FontSize="14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- B. Update Available Mode -->
            <StackPanel Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                <!-- Version Info Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Yeni versiya təqdim olunub!"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13">
                                <Run Text="Cari versiya: " />
                                <Run Text="{Binding CurrentVersion}" FontWeight="SemiBold" />
                                <Run Text="  ➔  Yeni versiya: " />
                                <Run Text="{Binding TargetVersion}" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </TextBlock>
                        </StackPanel>
                        <!-- Authenticity Badge -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24"
                                               FontSize="16"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                               Margin="0,0,6,0" />
                                <TextBlock Text="Təsdiqlənib"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Release Notes -->
                <TextBlock Text="Dəyişikliklər siyahısı:"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="0,0,0,6" />
                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        MaxHeight="160">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ReleaseNotes}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   LineHeight="18" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- C. Downloading Mode -->
            <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                        Margin="0,10,0,10">
                <TextBlock Text="Yeniləmə paketi yüklənir..."
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBlock Text="Zəhmət olmasa gözləyin, yeni versiyanın faylları serverdən endirilir."
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,16" />

                <!-- Progress Bar & Percentage -->
                <Grid Margin="0,0,0,8">
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding DownloadProgress}"
                                 Height="10" />
                </Grid>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding DownloadProgress, StringFormat={}{0}%}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               HorizontalAlignment="Right" />
                </Grid>

                <TextBlock Text="Yükləmə tamamlandıqdan sonra proqram avtomatik yenidən başlayacaq."
                           FontSize="12"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <!-- D. Ready to Restart Mode -->
            <StackPanel Visibility="{Binding IsReadyToRestart, Converter={StaticResource BoolToVis}}"
                        Margin="0,10,0,10">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                           FontSize="22"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           Margin="0,0,8,0" />
                            <TextBlock Text="Yeniləmə quraşdırılmağa hazırdır!"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   LineHeight="19">
                            <Run Text="Yeni versiya (" />
                            <Run Text="{Binding TargetVersion}" FontWeight="SemiBold" />
                            <Run Text=") artıq uğurla endirilib. Dəyişikliklərin tətbiq olunması üçün tətbiqi yenidən başlatmaq lazımdır." />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- E. Up to Date Mode -->
            <StackPanel Visibility="{Binding IsUpToDate, Converter={StaticResource BoolToVis}}"
                        Margin="0,10,0,10">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                           FontSize="22"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           Margin="0,0,8,0" />
                            <TextBlock Text="Tətbiq aktualdır"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   LineHeight="19">
                            <Run Text="Siz artıq StockDesk-in ən son versiyasından (" />
                            <Run Text="{Binding CurrentVersion}" FontWeight="SemiBold" />
                            <Run Text=") istifadə edirsiniz. Heç bir yeniləmə tələb olunmur." />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- F. Network Error Mode -->
            <StackPanel Visibility="{Binding IsNetworkError, Converter={StaticResource BoolToVis}}"
                        Margin="0,10,0,10">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Warning24"
                                           FontSize="22"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Margin="0,0,8,0" />
                            <TextBlock Text="Yeniləmə yoxlanıla bilmədi"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Yeniləmə serveri ilə əlaqə yaratmaq mümkün olmadı. Zəhmət olmasa internet bağlantınızı yoxlayın və ya bir az sonra yenidən cəhd edin."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   LineHeight="19"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- G. Dev Mode -->
            <StackPanel Visibility="{Binding IsDevMode, Converter={StaticResource BoolToVis}}"
                        Margin="0,10,0,10">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Info24"
                                           FontSize="22"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Margin="0,0,8,0" />
                            <TextBlock Text="Tərtibatçı rejimi"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Yeniləmələrin yoxlanılması tərtibatçı rejimində (portable / unpackaged mode) aktiv deyil."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   LineHeight="19" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>

        <!-- 3. ACTIONS FOOTER -->
        <Grid Grid.Row="2">

            <!-- Buttons for UpdateAvailable -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                <ui:Button Content="Sonra"
                           Appearance="Secondary"
                           Command="{Binding CloseCommand}"
                           Margin="0,0,8,0" />
                <ui:Button Content="İndi yenilə"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon ArrowDownload24}"
                           Command="{Binding StartDownloadCommand}" />
            </StackPanel>

            <!-- Buttons for Downloading -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                <ui:Button Content="Ləğv et"
                           Appearance="Secondary"
                           Command="{Binding CloseCommand}" />
            </StackPanel>

            <!-- Buttons for ReadyToRestart -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsReadyToRestart, Converter={StaticResource BoolToVis}}">
                <ui:Button Content="Sonra"
                           Appearance="Secondary"
                           Command="{Binding CloseCommand}"
                           Margin="0,0,8,0" />
                <ui:Button Content="Quraşdır və yenidən başlat"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding ApplyAndRestartCommand}" />
            </StackPanel>

            <!-- Buttons for UpToDate -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsUpToDate, Converter={StaticResource BoolToVis}}">
                <ui:Button Content="Oldu"
                           Appearance="Primary"
                           Command="{Binding CloseCommand}" />
            </StackPanel>

            <!-- Buttons for NetworkError -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsNetworkError, Converter={StaticResource BoolToVis}}">
                <ui:Button Content="Bağla"
                           Appearance="Secondary"
                           Command="{Binding CloseCommand}"
                           Margin="0,0,8,0" />
                <ui:Button Content="Yenidən cəhd et"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding RetryCheckCommand}" />
            </StackPanel>

            <!-- Buttons for DevMode -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsDevMode, Converter={StaticResource BoolToVis}}">
                <ui:Button Content="Bağla"
                           Appearance="Primary"
                           Command="{Binding CloseCommand}" />
            </StackPanel>

        </Grid>
    </Grid>
</Window>
