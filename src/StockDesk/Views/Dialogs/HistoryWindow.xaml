<Window x:Class="StockDesk.Views.Dialogs.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:StockDesk.ViewModels"
        xmlns:converters="clr-namespace:StockDesk.Common.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:HistoryViewModel}"
        Title="Əməliyyat Tarixçəsi və Jurnal"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Height="650" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.Resources>
        <converters:OperationTypeToColorConverter x:Key="OpColorConverter" />
        <converters:OperationTypeToNameConverter x:Key="OpNameConverter" />
        <converters:QuantityDeltaFormatConverter x:Key="DeltaFormatConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Əməliyyat Tarixçəsi"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="Bütün mədaxil və məxaric hərəkətlərinin dəyişdirilməz jurnalı"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding TotalOperationsCount, StringFormat='{}Cəmi əməliyyat: {0}'}"
                       FontWeight="Medium"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Filters Bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Operation Type Filter -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Növ" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,2" />
                    <ComboBox ItemsSource="{Binding OperationTypes}"
                              SelectedItem="{Binding SelectedOperationType}"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- Date From -->
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Tarixdən" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,2" />
                    <DatePicker SelectedDate="{Binding FromDate}" HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- Date To -->
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Tarixədək" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,2" />
                    <DatePicker SelectedDate="{Binding ToDate}" HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- Recipient Search -->
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Təhvil alan şəxs/şöbə" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,2" />
                    <ui:TextBox PlaceholderText="Ada görə axtarış..."
                                Text="{Binding RecipientFilter, UpdateSourceTrigger=PropertyChanged}"
                                Icon="{ui:SymbolIcon Search24}" />
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <ui:Button Content="Axtar"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Filter24}"
                               Command="{Binding LoadHistoryCommand}"
                               Margin="0,0,6,0" />
                    <ui:Button Content="Sıfırla"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon ArrowReset24}"
                               Command="{Binding ResetFiltersCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- History DataGrid -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Operations}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                      Background="Transparent"
                      RowBackground="Transparent"
                      AlternatingRowBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                      BorderThickness="0"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- Date & Time -->
                    <DataGridTextColumn Header="Tarix və Saat"
                                        Binding="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                        Width="130" />

                    <!-- Operation Type Badge -->
                    <DataGridTemplateColumn Header="Əməliyyat Növü" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding OperationType, Converter={StaticResource OpColorConverter}}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OperationType, Converter={StaticResource OpNameConverter}}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Product Name -->
                    <DataGridTextColumn Header="Məhsul"
                                        Binding="{Binding ProductNameSnapshot}"
                                        FontWeight="Medium"
                                        Width="*" />

                    <!-- Category -->
                    <DataGridTextColumn Header="Kateqoriya"
                                        Binding="{Binding CategoryNameSnapshot}"
                                        Width="130" />

                    <!-- Quantity -->
                    <DataGridTemplateColumn Header="Miqdar" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding QuantityDelta, Converter={StaticResource DeltaFormatConverter}}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding OperationType, Converter={StaticResource OpColorConverter}}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Recipient -->
                    <DataGridTextColumn Header="Təhvil Alan"
                                        Binding="{Binding RecipientNameSnapshot}"
                                        Width="150" />

                    <!-- Note -->
                    <DataGridTextColumn Header="Qeyd"
                                        Binding="{Binding Note}"
                                        Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <ui:Button Content="Bağla"
                       Appearance="Secondary"
                       Click="OnCloseClick"
                       Width="100" />
        </StackPanel>
    </Grid>
</Window>
